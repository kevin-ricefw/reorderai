# Wecomm Azure PostgreSQL via SSH tunnel
# localhost:5433 -> wecomm.postgres.database.azure.com:5432
# Keep SSH tunnel running before starting the API.

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=postgres
DB_USERNAME=wecomm_admin
DB_PASSWORD=
DB_SSLMODE=require

# OpenAI (optional — chatbot / Step 6 justification)
OPENAI_API_KEY=
